{
	"name": "seyfert",
	"version": "5.0.0",
	"description": "The most advanced framework for discord bots",
	"packageManager": "pnpm@11.11.0",
	"workspaces": [
		"tests",
		"tests/local-seyfert"
	],
	"main": "./lib/index.js",
	"module": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"files": [
		"lib/**"
	],
	"scripts": {
		"build": "tsc --outDir ./lib",
		"bench:limited-cache": "pnpm run build && node --expose-gc ./benchmarks/limited-cache.mjs",
		"prepublishOnly": "npm run build",
		"prepare": "npm run build && husky",
		"lint": "biome lint --write ./src",
		"format": "biome format --write ./src",
		"check-h": "biome check --write ./src",
		"check": "biome check --verbose --no-errors-on-unmatched ./src ./tests ./package.json ./tsconfig.json ./biome.json ./commitlint.config.js",
		"check:write": "biome check --verbose --write --no-errors-on-unmatched ./src ./tests ./package.json ./tsconfig.json ./biome.json ./commitlint.config.js",
		"test:types": "pnpm run build && tsc --noEmit --project tests/tsconfig.json",
		"test": "pnpm run test:types && vitest run --config ./tests/vitest.config.mts ./tests/"
	},
	"author": "MARCROCK22",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@changesets/cli": "^2.31.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^26.1.1",
		"husky": "^9.1.7",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"homepage": "https://seyfert.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tiramisulabs/seyfert.git"
	},
	"bugs": {
		"url": "https://github.com/tiramisulabs/seyfert"
	},
	"keywords": [
		"api",
		"discord",
		"bots",
		"typescript",
		"botdev"
	],
	"publishConfig": {
		"access": "public"
	},
	"maintainers": [
		{
			"name": "socram03",
			"url": "https://github.com/socram03"
		}
	],
	"contributors": [
		{
			"name": "Free 公園",
			"url": "https://github.com/FreeAoi"
		},
		{
			"name": "David",
			"url": "https://github.com/Drylozu"
		}
	]
}
