{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/src/**",
			"**/tests/**",
			"/biome.json",
			"/commitlint.config.js",
			"/package.json",
			"/tsconfig.json",
			"!/node_modules/",
			"!/build",
			"!/lib",
			"!/__test__",
			"!/.vscode"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120,
		"lineEnding": "lf",
		"formatWithErrors": true
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"security": {
				"noGlobalEval": "off"
			},
			"suspicious": {
				"preset": "none",
				"noExplicitAny": "off",
				"noAssignInExpressions": "off",
				"useAwait": "off",
				"noConfusingVoidType": "off",
				"noAsyncPromiseExecutor": "off",
				"noUnsafeDeclarationMerging": "off",
				"noEmptyInterface": "off",
				"noThenProperty": "off",
				"noShadowRestrictedNames": "off",
				"useIterableCallbackReturn": "off"
			},
			"correctness": {
				"noUnusedVariables": "off",
				"noNodejsModules": "off",
				"useImportExtensions": "off",
				"noUnusedFunctionParameters": "off"
			},
			"style": {
				"noDefaultExport": "off",
				"useBlockStatements": "off",
				"noParameterProperties": "off",
				"useNamingConvention": "off",
				"noNonNullAssertion": "off",
				"useForOf": "off",
				"useDefaultSwitchClause": "off",
				"noParameterAssign": "off",
				"useFilenamingConvention": "off",
				"useEnumInitializers": "off",
				"useExplicitLengthCheck": "off",
				"useImportType": "error"
			},
			"complexity": {
				"noForEach": "off",
				"noExcessiveCognitiveComplexity": "off",
				"noUselessConstructor": "off",
				"noBannedTypes": "off"
			},
			"performance": {
				"noBarrelFile": "off",
				"noDelete": "off",
				"noDynamicNamespaceImportAccess": "off",
				"noReExportAll": "off",
				"useTopLevelRegex": "off",
				"noNamespaceImport": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"arrowParentheses": "asNeeded",
			"bracketSameLine": true
		}
	},
	"overrides": [
		{
			"includes": ["tests/**/*-contract.ts", "tests/command-declare-name-combinations.ts"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["tests/public-entrypoint-cycles.test.mts"],
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			}
		}
	]
}
